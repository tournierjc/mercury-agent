# Mercury from source, dashboard included — the OpenUI rig.
# Unlike Dockerfile.rig (API only), this one runs the full `npm run build`, so
# `ui/dist` exists and the React dashboard is served. Test rig, not a release image.
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Europe/Paris \
    MERCURY_NO_UPDATE_CHECK=1 \
    HOME=/home/node

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git curl jq ripgrep procps less tini tzdata \
      python3 make g++ \
 && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY package.json package-lock.json ./
# --include=dev: NODE_ENV=production above makes npm skip tsup and vite otherwise.
RUN npm ci --include=dev --no-audit --no-fund
COPY . .
# Full build: tsup for the server, then scripts/post-build.cjs installs the UI
# dependencies and runs vite, which is what puts ui/dist on disk.
RUN npm run build && ls -la ui/dist | head -5

# Production at runtime only: with NODE_ENV=production during the build, the UI's own
# `npm ci` skips vite and @vitejs/plugin-react, and the dashboard build dies.
ENV NODE_ENV=production

RUN mkdir -p /work && chown -R node:node /src /work
USER node
WORKDIR /work
CMD ["tini", "--", "node", "/src/dist/index.js", "start", "--daemon"]
